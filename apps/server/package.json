{
  "name": "@loom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://loom:loom@localhost:5432/loom_test_server} vitest run",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.3.0",
    "@loom/api-contract": "workspace:*",
    "@loom/application": "workspace:*",
    "@loom/db": "workspace:*",
    "@loom/domain": "workspace:*",
    "@loom/runner-protocol": "workspace:*",
    "@orpc/client": "^1.14.10",
    "@orpc/contract": "^1.14.10",
    "@orpc/server": "^1.14.10",
    "@types/ws": "^8.18.1",
    "better-auth": "1.6.25",
    "fastify": "^5.10.0",
    "ioredis": "^5.9.0",
    "web-push": "3.6.7",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
