{
  "name": "loom",
  "private": true,
  "license": "MIT",
  "description": "A self-hosted workspace for swarms of AI coding agents — clone-per-run isolation, container sandboxes, human-in-the-loop approval, and a merge queue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raminjafary/loom.git"
  },
  "homepage": "https://github.com/raminjafary/loom#readme",
  "bugs": {
    "url": "https://github.com/raminjafary/loom/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agent",
    "multi-agent",
    "agent-orchestration",
    "claude",
    "llm",
    "self-hosted",
    "sandbox",
    "developer-tools",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && pnpm typecheck:tools",
    "//typecheck:tools": "tools/ is not a workspace package — the drivers are scripts, not a library — so turbo never saw them and a .mts driver could rot for months. It had: reseed-builtins.mts still wrote a column removed several migrations ago.",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @loom/db db:generate",
    "db:migrate": "pnpm --filter @loom/db db:migrate",
    "db:test:prepare": "bash tools/prepare-test-dbs.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@orpc/client": "1.14.10",
    "@orpc/contract": "1.14.10",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
