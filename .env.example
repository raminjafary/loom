DATABASE_URL=postgres://loom:loom@localhost:5432/loom
# Separate database for `pnpm -r test` — create it once with:
# docker compose exec postgres psql -U loom -d loom -c "CREATE DATABASE loom_test;"
# DATABASE_URL=postgres://loom:loom@localhost:5432/loom_test pnpm db:migrate
TEST_DATABASE_URL=postgres://loom:loom@localhost:5432/loom_test
VALKEY_URL=redis://localhost:6379

SERVER_PORT=3001
WS_GATEWAY_PORT=3002
WEB_ORIGIN=http://localhost:5173

BETTER_AUTH_SECRET=dev-only-change-me-to-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3001

# Shared by apps/server (which signs) and apps/ws-gateway (which verifies), and the whole
# authentication of /ws/client — a workspace's entire agent transcript is behind it
#. Refused at boot if under 32 chars or still example-shaped.
# Generate one: openssl rand -base64 32
WS_SUBSCRIPTION_SECRET=

# --- Sandbox + egress ---
# The real model key lives ONLY here, read by the egress-proxy container. It is
# never passed into a sandbox: a run presents an opaque per-run lease token and
# the proxy attaches this. That is the load-bearing control in the credential broker — "secrets
# never enter the sandbox" — so do not also export it to apps/runner.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Shared secret the Runner uses on the proxy's host-only control plane to lease
# and revoke run tokens. Any 16+ random chars.
# Refused at boot if it still looks like an example, or is under 32 chars: a sandbox can
# reach this port, so this secret is the boundary in front of lease
# issuance. Generate one: openssl rand -base64 32
LOOM_EGRESS_CONTROL_SECRET=
# Optional comma-separated override of the egress allowlist. Empty = the default
# package-registry list in packages/domain/src/egress-policy.ts.
EGRESS_ALLOWED_HOSTS=
# Set to 1 to log the header names the proxy forwards upstream (names only, never
# values). Useful when diagnosing which auth shape the SDK is sending.
LOOM_EGRESS_TRACE_HEADERS=0

# Container runtime used for per-run sandboxes. Defaults to docker; podman is
# drop-in.
LOOM_CONTAINER_RUNTIME=docker
# Set to 0 only to run agents unsandboxed on the host, which is what Phase 1 did
# before the sandbox existed. Unsandboxed, model output executes with the Runner's own
# user privileges: one Bash call can read your login keychain, ~/.ssh, ~/.aws, and every
# repository on this machine. Because that is categorically worse
# than "less isolated", it also requires the acknowledgement below — this variable alone
# does nothing.
LOOM_SANDBOX_ENABLED=1
LOOM_ALLOW_UNSANDBOXED=

# Lets the Runner use the operator's existing Claude Code sign-in instead of an API
# key. Explicit opt-in because it grants the Runner process a capability it otherwise
# does not have: reading the login keychain (macOS) or ~/.claude/.credentials.json
# (Linux).
#
# Nothing about this puts a credential in a sandbox. The Runner reads the short-lived
# OAuth access token host-side and hands it to the egress proxy over the loopback
# control plane; the sandbox is given only its opaque lease token, in a credentials
# file the CLI accepts. The real token never crosses into a container, is never
# written to disk by Loom, and is never logged.
#
# Licensing: the tech stack records that the SDK's terms prohibit exposing claude.ai
# subscription limits to *your users*. A single operator running their own Loom is one
# reading of that; a team workspace on one person's subscription is the case the term
# is about. ANTHROPIC_API_KEY above remains supported for that reason.
LOOM_USE_HOST_CLAUDE_AUTH=0

# Where the Runner keeps per-run state so a restart can resume rather than lose runs
#. Defaults to ~/.loom/runner-state.
LOOM_RUNNER_STATE_DIR=

# How long a worker-notes write or read may wait for the server before the tool tells
# the model it was not saved. Defaults to 30000.
#
# Bounded, unlike an approval gate, which may legitimately wait as long as a human
# takes: a note is answered within a round-trip, so an unanswered one means the socket
# dropped — and a note tool that never returns would hang the agent loop that called
# it, turning a bookkeeping failure into a stalled run.
LOOM_NOTE_TIMEOUT_MS=

# Web push notifications.
# Read only by apps/server. With both keys unset the server reports notifications
# as unconfigured and the UI says so, rather than offering a subscribe button
# that cannot work — every other Phase 1 path is unaffected.
#
# Generate a pair with: npx web-push generate-vapid-keys
#
# The private key is a signing key: it identifies this deployment to every push
# service it talks to. Treat it like BETTER_AUTH_SECRET.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifies the operator to the push service so it can make contact if this
# deployment misbehaves. `mailto:` or an https URL.
VAPID_SUBJECT=mailto:operator@localhost
